# Local development only. Change passwords before use; never commit .env.
MYSQL_DATABASE=reef_panda_arena
MYSQL_USER=arena_app
MYSQL_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DISTINCT_LOCAL_ROOT_PASSWORD
# Generate 32 random bytes and encode as base64.
ARENA_ENCRYPTION_KEY_BASE64=REPLACE_WITH_BASE64_KEY
# MySQL connect <=10s and read <=30s; tighter positive URL values are kept.
# asyncmy does not support a separate write_timeout URL option.
ARENA_DATABASE_URL=mysql+asyncmy://arena_app:REPLACE_WITH_LOCAL_PASSWORD@localhost/reef_panda_arena?charset=utf8mb4
ARENA_DATABASE_SOCKET=.mysql-socket/mysqld.sock
ARENA_OLLAMA_URL=http://127.0.0.1:11434
ARENA_MODEL=qwen3:1.7b
# Audit mode enforces one active experiment across API and CLI families.
ARENA_AUDIT_MODE=true
ARENA_MAX_CONCURRENT_RUNS=2

# Public transport controls are reproducible, not unknown-secret trials.
ARENA_FIXTURE_MODE=key_derived_unknown
